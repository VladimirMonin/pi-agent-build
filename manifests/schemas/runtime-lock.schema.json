{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pi-agent-build/runtime-lock.schema.json",
  "title": "Pi Agent runtime lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "platform", "runtime", "compatibility", "releaseTagFormat"],
  "properties": {
    "$schema": { "const": "./schemas/runtime-lock.schema.json" },
    "schemaVersion": { "const": 1 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": { "const": "windows" },
        "architecture": { "enum": ["x64", "arm64"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "pi"],
      "properties": {
        "node": { "$ref": "#/$defs/semver" },
        "npm": { "$ref": "#/$defs/semver" },
        "pi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package", "version"],
          "properties": {
            "package": { "type": "string", "minLength": 1 },
            "version": { "$ref": "#/$defs/semver" }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumNode", "reason"],
      "properties": {
        "minimumNode": { "$ref": "#/$defs/semver" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "releaseTagFormat": {
      "type": "string",
      "pattern": "^pi-v<pi-version>-build\\.<number>$"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
