{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pi-agent-build/pi-packages-lock.schema.json",
  "title": "Pi profile package lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "profiles"],
  "properties": {
    "$schema": { "const": "./schemas/pi-packages-lock.schema.json" },
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "codeOnly"],
      "properties": {
        "common": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package" }
        },
        "codeOnly": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/package" }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "package", "version"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:npm:.+@[0-9]+\\.[0-9]+\\.[0-9]+|https://github\\.com/[^/]+/[^@]+@[0-9a-f]{40})$"
        },
        "package": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "kind": { "const": "git-commit" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tagObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "releaseTag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "patch": { "type": "string", "minLength": 1 },
        "taskProfilePatch": { "type": "string", "minLength": 1 },
        "enabledExtensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "state": { "enum": ["installed-disabled"] },
        "reason": { "type": "string", "minLength": 1 },
        "external": {
          "type": "string",
          "pattern": "^.+@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "compatibilityNote": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": { "pattern": "^https://github\\.com/" }
            },
            "required": ["source"]
          },
          "then": {
            "required": ["kind", "commit", "tagObject", "releaseTag"],
            "properties": {
              "kind": { "const": "git-commit" }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["kind"] },
                { "required": ["commit"] },
                { "required": ["tagObject"] },
                { "required": ["releaseTag"] }
              ]
            }
          }
        }
      ]
    }
  }
}
