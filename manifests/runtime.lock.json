{
  "$schema": "./schemas/runtime-lock.schema.json",
  "schemaVersion": 1,
  "platform": {
    "os": "windows",
    "architecture": "x64"
  },
  "runtime": {
    "node": "25.8.1",
    "npm": "11.11.0",
    "pi": {
      "package": "@earendil-works/pi-coding-agent",
      "version": "1.5.2"
    }
  },
  "compatibility": {
    "minimumNode": "22.19.0",
    "reason": "pi core 1.5.2 and pi-session-search 1.6.0 engines require Node 22.19+; the build is exercised on Node 24+ (lab pin 25.8.1)"
  },
  "releaseTagFormat": "pi-v<pi-version>-build.<number>"
}
