    "npm:pi-goal-x@0.32.3",
    "npm:pi-intercom@0.16.1",
    {
      "source": "npm:pi-background-tasks@2.6.2",
      "extensions": []
    },
    "npm:pi-session-search@1.6.0",
    "npm:@samfp/pi-memory@1.5.0",
    "npm:pi-mcp-adapter@2.36.0",
    "npm:@nicknisi/pi-ast-grep@0.2.1",
    "npm:@bacnh85/pi-serena@0.9.20",
